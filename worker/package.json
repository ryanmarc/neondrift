{
  "name": "neondrift-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute neondrift --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute neondrift --env dev --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
